# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
venv/
.venv/
env/

# Jupyter
.ipynb_checkpoints/

# Testing
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store

# --- Project data -----------------------------------------------------
# Raw M5 files must never be committed (large, and redistributing the
# competition data isn't ours to do). Every other data/ stage is
# regenerated by running the pipeline, so it's ignored too.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Artifacts (Phase 2+) ----------------------------------------------
# Model binaries and large forecast/metric files are regenerated by
# the pipeline, not hand-edited, and can be sizable.
artifacts/models/*
!artifacts/models/.gitkeep
artifacts/forecasts/*
!artifacts/forecasts/.gitkeep
artifacts/metrics/*
!artifacts/metrics/.gitkeep
artifacts/residuals/*
!artifacts/residuals/.gitkeep
artifacts/inventory/*
!artifacts/inventory/.gitkeep
